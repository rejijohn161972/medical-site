# Copy this file to ".env" and fill in real values, OR run 1_FIRST_TIME_SETUP.bat
# which writes the configuration for you. NEVER commit the real .env file.
#
# These can also be set as Windows environment variables instead of a file.

# ProviderFlow website login (the same username/password used in Chrome)
PF_USERNAME=
PF_PASSWORD=

# OpenAI API key (starts with sk-...). Used to read the patient name/DOB/type.
OPENAI_API_KEY=
# OpenAI model. gpt-4o is the documented default for this tool.
OPENAI_MODEL=gpt-4o

# Where sorted patient folders are written.
OUTPUT_DIR=C:\FaxOutput

# Base URL of the ProviderFlow portal.
PF_BASE_URL=https://secure.providerflow.com

# Set to 1 to watch the browser work (useful for first run / troubleshooting).
# Leave 0 for the automatic 8:45 AM run so it stays invisible.
PF_HEADED=0
